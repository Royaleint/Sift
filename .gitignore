# Private dev workspace (nested git repo, separately tracked)
Sift_Dev/

# Local git worktrees
.worktrees/

# Agent / tool layer (Claude Code, Codex)
.claude/
.codex/

# Agent-entry docs — canonical lives in Sift_Dev/agent-entry/, hardlinked to root (STU-046)
CLAUDE.md
AGENTS.md

# WoW packager working files
.release/
.pkgmeta-cache/

# Build-matrix dev-build files (generated by the DevBuild TOC generator, never
# committed). Committing either ships a second TOC to every user and loads the
# addon twice. This ignore and the matching .pkgmeta entries are the ONLY
# defense — the STU-064 TOC-vs-zip CI check does not count TOCs. (BSP-070)
Sift_DevBuild.toc
DevBuildGuard.lua

# Libraries: vendored directly in-repo (no .pkgmeta externals — manual vendor pattern)
# Libs/ is tracked. Do not re-add this ignore.

# Build artifacts
*.zip
*.tar.gz

# Windows junk
Thumbs.db
nul
desktop.ini

# Editor / IDE
.vscode/
.idea/

# Brainstorm artifacts (visual companion server)
.superpowers/
*.swp
*.swo
*~

# Secrets
.env
.env.local
*.key
