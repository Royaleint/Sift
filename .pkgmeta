package-as: Sift

enable-nolib-creation: no
enable-toc-creation: yes

manual-changelog:
  filename: RELEASE_NOTES.html
  markup-type: html

# No `externals:` block — Sift vendors its libraries directly in Libs/
# (see .gitignore: "Libs/ is tracked … manual vendor pattern"). The packager
# ships them as-is from the checkout rather than fetching them at build time.

ignore:
  - .git
  - .gitignore
  - .github
  - .pkgmeta
  - .release
  - .worktrees
  - .claude
  - .codex
  - AGENTS.md
  # Drop only the agent doc; README.md (+ packager-generated CHANGELOG) ship.
  # NOTE: no inline comments on ignore entries — the packager reads them literally.
  - Sift_Dev
  - CLAUDE.md
  - RELEASE_NOTES.md
  - RELEASE_NOTES.html
  # Build-matrix dev-build files (BSP-070). Generated and gitignored, listed
  # here too: shipping either gives every user a second TOC and a double-loaded
  # addon. This is not belt-and-braces — check-toc-vs-zip.mjs verifies that
  # TOC-referenced files exist, never that only one TOC does, so these two
  # entries and the .gitignore rules are the whole defense.
  - Sift_DevBuild.toc
  - DevBuildGuard.lua
