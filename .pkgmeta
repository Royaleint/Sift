package-as: Sift

enable-nolib-creation: no
enable-toc-creation: yes

manual-changelog:
  filename: RELEASE_NOTES.html
  markup-type: html

# No `externals:` block: libraries are vendored in Libs/ and ship from the
# checkout as-is.

ignore:
  - .git
  - .gitignore
  - .gitattributes
  - .github
  - .pkgmeta
  - .release
  - .worktrees
  - .claude
  - .codex
  - AGENTS.md
  # Drop only the agent doc; README.md (+ packager-generated CHANGELOG) ship.
  # NOTE: no inline comments on ignore entries — the packager reads them literally.
  - Sift_Dev
  - tests
  - CLAUDE.md
  - RELEASE_NOTES.md
  - RELEASE_NOTES.html
  # Dev-build files: generated and gitignored, but listed here too. Shipping
  # either gives every user a second TOC and a double-loaded addon, and
  # check-toc-vs-zip.mjs does not check for an extra TOC, so these entries
  # and .gitignore are the only defense.
  - Sift_DevBuild.toc
  - DevBuildGuard.lua

# BawrSpam/ is a code-free companion folder that ships beside Sift so the
# packaged zip carries two top-level addon folders. Without this it would
# ship nested inside Sift/ instead of beside it.
move-folders:
  Sift/BawrSpam: BawrSpam
